{
  "name": "@priolo/jack",
  "version": "0.2.16",
  "private": false,
  "description": "CARD interface",
  "author": "Iorio Ivano <iorioivano@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/priolo/jack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priolo/jack.git"
  },
  "keywords": [
    "ui",
    "ux",
    "react",
    "card"
  ],
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./style.css": "./dist/jack.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --port 5174",
    "build": "vite build --sourcemap",
    "build:watch": "vite build --sourcemap -w",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "pub": "npm publish --access public"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "react-virtuoso": "^4.14.0",
    "slate": "^0.123.0",
    "slate-history": "^0.113.1",
    "slate-react": "^0.123.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/prismjs": "^1.26.5",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@priolo/jon": "^1.1.0",
    "jsdom": "latest",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.7.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@priolo/jon": "^1.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "browserslist": "defaults and supports es6-module,maintained node versions"
}
